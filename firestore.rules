rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.uid == 'REPLACE_WITH_YOUR_FIREBASE_UID';
    }
    function validData() {
      return request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
        && request.resource.data.keys().hasAll(['payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 300000
        && request.resource.data.revision is int
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/matrices/main {
      allow read: if owner(uid);
      allow create: if owner(uid) && validData() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validData()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
